<Window x:Class="WpfKosc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gra w kości" Height="450" Width="400" Background="#ED27C121">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <UniformGrid Columns="3" Margin="10">
            <Image x:Name="Img0" Source="/kosc0.png" Width="80" Margin="10" MouseLeftButtonDown="Image_Click"/>
            <Image x:Name="Img1" Source="/kosc0.png" Width="80" Margin="10" MouseLeftButtonDown="Image_Click"/>
            <Image x:Name="Img2" Source="/kosc0.png" Width="80" Margin="10" MouseLeftButtonDown="Image_Click"/>
            <Image x:Name="Img3" Source="/kosc0.png" Width="80" Margin="10" MouseLeftButtonDown="Image_Click"/>
            <Image x:Name="Img4" Source="/kosc0.png" Width="80" MouseLeftButtonDown="Image_Click"/>
        </UniformGrid>

        <Button Content="RZUT" Click="Button_Click" Background="#ED275021" Foreground="White" 
                FontSize="20" Padding="20,10" Margin="10" HorizontalAlignment="Center"/>

        <TextBlock x:Name="TxtWynik" Text="0" FontSize="40" HorizontalAlignment="Center" Margin="10"/>
    </StackPanel>
</Window>